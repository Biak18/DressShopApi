<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Central Package Management (Directory.Packages.props) requires an
    unambiguous package source per package once more than one source is
    configured (NU1507) - see https://aka.ms/nuget-package-source-mapping.

    This file is scoped to this solution only (NuGet walks up the directory
    tree from the .sln looking for NuGet.Config) - it does not change your
    machine-wide NuGet sources, so any DevExpress/other tooling elsewhere on
    this machine is unaffected.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
